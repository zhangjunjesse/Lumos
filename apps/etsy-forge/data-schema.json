{
  "$schema": "https://lumos.io/schemas/app-data-schema.v1.json",
  "collections": [
    {
      "name": "etsy_forge_collection_tasks",
      "label": "关键词采集任务",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "keyword", "type": "string", "label": "关键词", "required": true, "indexed": true },
        { "name": "source", "type": "enum", "label": "平台", "options": ["etsy"], "default": "etsy", "indexed": true },
        { "name": "enabled", "type": "boolean", "label": "启用", "default": true, "indexed": true },
        { "name": "schedule", "type": "enum", "label": "调度频率", "options": ["manual", "hourly", "daily", "weekly"], "default": "manual", "indexed": true },
        { "name": "max_products", "type": "integer", "label": "每次爬商品数", "default": 24 },
        { "name": "min_sales", "type": "integer", "label": "采集门槛·最低销量（0=不限，需 EHunt）", "default": 0 },
        { "name": "min_favorites", "type": "integer", "label": "采集门槛·最低收藏（0=不限，需 EHunt）", "default": 0 },
        { "name": "min_price", "type": "number", "label": "采集门槛·最低价格（0=不限，按标价）", "default": 0 },
        { "name": "max_price", "type": "number", "label": "采集门槛·最高价格（0=不限，按标价）", "default": 0 },
        { "name": "max_pages", "type": "integer", "label": "最大翻页数（默认 40，上限 100）", "default": 40 },
        { "name": "total_collected", "type": "integer", "label": "累积商品数", "default": 0 },
        { "name": "last_run_id", "type": "string", "label": "最近运行记录" },
        { "name": "last_run_at", "type": "datetime", "label": "最近运行时间", "indexed": true },
        { "name": "last_status", "type": "enum", "label": "最近状态", "options": ["idle", "running", "success", "failed", "partial", "cancelled"], "default": "idle", "indexed": true },
        { "name": "last_failure_reason", "type": "text", "label": "最近失败原因" },
        { "name": "last_collected_count", "type": "integer", "label": "最近一次商品数", "default": 0 },
        { "name": "next_run_at", "type": "datetime", "label": "下次运行时间" },
        { "name": "created_at", "type": "datetime", "label": "创建时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["keyword"], ["source"], ["enabled"], ["schedule"], ["last_status"], ["last_run_at"]]
    },
    {
      "name": "etsy_forge_products",
      "label": "采集到的商品",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "task_id", "type": "string", "label": "采集任务", "indexed": true },
        { "name": "keyword", "type": "string", "label": "关键词", "indexed": true },
        { "name": "source", "type": "enum", "label": "平台", "options": ["etsy"], "default": "etsy" },
        { "name": "listing_id", "type": "string", "label": "Etsy listing ID", "indexed": true },
        { "name": "title", "type": "text", "label": "标题" },
        { "name": "url", "type": "string", "label": "商品 URL", "required": true },
        { "name": "main_image_url", "type": "string", "label": "主图 URL" },
        { "name": "price", "type": "string", "label": "价格" },
        { "name": "rating", "type": "string", "label": "评分" },
        { "name": "reviews", "type": "string", "label": "评论数" },
        { "name": "sales", "type": "string", "label": "销量(列表展示)" },
        { "name": "ehunt_json", "type": "text", "label": "EHunt 指标（JSON：销量/收藏/上架日期等）" },
        { "name": "ehunt_status", "type": "enum", "label": "EHunt 采集状态", "options": ["ok", "no_ehunt", "not_adspower", "bridge_unavailable", "failed"], "default": "failed", "indexed": true },
        { "name": "selected", "type": "boolean", "label": "已勾选（待爬详情）", "default": false, "indexed": true },
        { "name": "detail_status", "type": "enum", "label": "详情图采集状态", "options": ["idle", "running", "success", "failed"], "default": "idle", "indexed": true },
        { "name": "detail_image_count", "type": "integer", "label": "已采集详情图数", "default": 0 },
        { "name": "detail_failure_reason", "type": "text", "label": "详情采集失败原因" },
        { "name": "tags", "type": "json", "label": "用户标签", "default": [] },
        { "name": "review_count", "type": "integer", "label": "已抓评论数", "default": 0 },
        { "name": "review_analysis", "type": "json", "label": "AI 评论分析（缓存）" },
        { "name": "review_analyzed_at", "type": "datetime", "label": "评论分析时间" },
        { "name": "cutout_status", "type": "enum", "label": "抠图状态", "options": ["idle", "running", "success", "partial", "failed"], "default": "idle", "indexed": true },
        { "name": "cutout_count", "type": "integer", "label": "已抠图数", "default": 0 },
        { "name": "asset_status", "type": "enum", "label": "素材分析状态", "options": ["idle", "running", "success", "partial", "failed"], "default": "idle", "indexed": true },
        { "name": "pose_status", "type": "enum", "label": "抠模特姿势状态", "options": ["idle", "running", "success", "partial", "failed"], "default": "idle", "indexed": true },
        { "name": "created_at", "type": "datetime", "label": "采集时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["task_id"], ["keyword"], ["listing_id"], ["selected"], ["detail_status"], ["ehunt_status"], ["created_at"]]
    },
    {
      "name": "etsy_forge_images",
      "label": "详情图（图库）",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "product_id", "type": "string", "label": "所属商品", "required": true, "indexed": true },
        { "name": "listing_id", "type": "string", "label": "Etsy listing ID", "indexed": true },
        { "name": "keyword", "type": "string", "label": "来源关键词", "indexed": true },
        { "name": "image_url", "type": "string", "label": "详情图 URL", "required": true },
        { "name": "local_path", "type": "string", "label": "下载后本地路径" },
        { "name": "image_type", "type": "enum", "label": "图类型(AI分类)", "options": ["model_scene", "product", "size", "color", "other"], "indexed": true },
        { "name": "is_main", "type": "boolean", "label": "是否主图", "default": false },
        { "name": "position", "type": "integer", "label": "在详情页顺序", "default": 0 },
        { "name": "created_at", "type": "datetime", "label": "采集时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["product_id"], ["listing_id"], ["keyword"], ["created_at"]]
    },
    {
      "name": "etsy_forge_reviews",
      "label": "商品评论",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "product_id", "type": "string", "label": "所属商品", "required": true, "indexed": true },
        { "name": "listing_id", "type": "string", "label": "Etsy listing ID", "indexed": true },
        { "name": "author", "type": "string", "label": "评论人" },
        { "name": "rating", "type": "string", "label": "评分" },
        { "name": "date", "type": "string", "label": "评论日期" },
        { "name": "region", "type": "string", "label": "地区" },
        { "name": "text", "type": "text", "label": "评论内容", "required": true },
        { "name": "created_at", "type": "datetime", "label": "采集时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["product_id"], ["listing_id"], ["created_at"]]
    },
    {
      "name": "etsy_forge_cutouts",
      "label": "抠图结果",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "product_id", "type": "string", "label": "所属商品", "required": true, "indexed": true },
        { "name": "source_count", "type": "integer", "label": "抠图用了几张图", "default": 0 },
        { "name": "cutout_path", "type": "string", "label": "抠图结果本地路径" },
        { "name": "status", "type": "enum", "label": "状态", "options": ["success", "failed"], "default": "failed", "indexed": true },
        { "name": "failure_reason", "type": "text", "label": "失败原因" },
        { "name": "created_at", "type": "datetime", "label": "抠图时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["product_id"], ["status"], ["created_at"]]
    },
    {
      "name": "etsy_forge_prompts",
      "label": "提示词库",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "category", "type": "enum", "label": "分类", "options": ["cutout", "scene", "model", "product", "pose", "product-merge", "remix-analyze", "remix-variant"], "default": "cutout", "indexed": true },
        { "name": "name", "type": "string", "label": "名称", "required": true },
        { "name": "content", "type": "text", "label": "提示词内容", "required": true },
        { "name": "is_default", "type": "boolean", "label": "当前生效", "default": false },
        { "name": "created_at", "type": "datetime", "label": "创建时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["category"], ["created_at"]]
    },
    {
      "name": "etsy_forge_assets",
      "label": "素材库（场景/模特/产品/模特姿势）",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "category", "type": "enum", "label": "类别", "options": ["scene", "model", "product", "pose", "remix"], "indexed": true },
        { "name": "product_id", "type": "string", "label": "来源商品", "indexed": true },
        { "name": "source_image_ids", "type": "json", "label": "来源原始图 ID", "default": [] },
        { "name": "description", "type": "text", "label": "AI 看图描述" },
        { "name": "image_path", "type": "string", "label": "素材图本地路径" },
        { "name": "status", "type": "enum", "label": "状态", "options": ["success", "failed"], "default": "failed", "indexed": true },
        { "name": "failure_reason", "type": "text", "label": "失败原因" },
        { "name": "quality_flag", "type": "enum", "label": "质量", "options": ["good", "weak"], "indexed": true },
        { "name": "quality_note", "type": "text", "label": "质量备注" },
        { "name": "created_at", "type": "datetime", "label": "创建时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["category"], ["product_id"], ["status"], ["created_at"]]
    },
    {
      "name": "etsy_forge_mockups",
      "label": "产品合成（带印花平铺 T）",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "design_label", "type": "string", "label": "印花来源描述" },
        { "name": "design_ref", "type": "string", "label": "印花来源(path/url，追溯用)" },
        { "name": "source_product_id", "type": "string", "label": "原始采集商品 id", "indexed": true },
        { "name": "product_asset_id", "type": "string", "label": "产品图素材 id", "indexed": true },
        { "name": "image_path", "type": "string", "label": "带印花 T 本地路径" },
        { "name": "status", "type": "enum", "label": "状态", "options": ["success", "failed"], "default": "failed", "indexed": true },
        { "name": "failure_reason", "type": "text", "label": "失败原因" },
        { "name": "created_at", "type": "datetime", "label": "创建时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["product_asset_id"], ["status"], ["created_at"]]
    },
    {
      "name": "etsy_forge_sop_runs",
      "label": "SOP 运行（一键出品）",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "sop_key", "type": "string", "label": "SOP 标识", "default": "one-click", "indexed": true },
        { "name": "product_ids", "type": "json", "label": "商品 ids" },
        { "name": "status", "type": "enum", "label": "状态", "options": ["running", "success", "partial", "failed", "cancelled"], "default": "running", "indexed": true },
        { "name": "total", "type": "number", "label": "商品数", "default": 0 },
        { "name": "started_at", "type": "datetime", "label": "开始时间", "indexed": true },
        { "name": "ended_at", "type": "datetime", "label": "结束时间" },
        { "name": "created_at", "type": "datetime", "label": "创建时间", "auto": "now" },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["status"], ["started_at"]]
    },
    {
      "name": "etsy_forge_sop_steps",
      "label": "SOP 步骤状态",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "run_id", "type": "string", "label": "运行 id", "indexed": true },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "product_id", "type": "string", "label": "商品 id", "indexed": true },
        { "name": "product_title", "type": "string", "label": "商品标题" },
        { "name": "step_key", "type": "enum", "label": "步骤", "options": ["detail", "review", "classify", "cutout", "assets", "remix", "mockup"], "indexed": true },
        { "name": "step_order", "type": "number", "label": "步骤序", "default": 0 },
        { "name": "status", "type": "enum", "label": "状态", "options": ["pending", "running", "success", "failed", "skipped"], "default": "pending", "indexed": true },
        { "name": "summary", "type": "string", "label": "成功摘要" },
        { "name": "failure_reason", "type": "text", "label": "失败原因" },
        { "name": "created_at", "type": "datetime", "label": "创建时间", "auto": "now" },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["run_id"], ["user_id"], ["product_id"], ["status"]]
    },
    {
      "name": "etsy_forge_logs",
      "label": "运行日志（排查图片生成成败）",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "level", "type": "enum", "label": "级别", "options": ["info", "warn", "error"], "default": "info", "indexed": true },
        { "name": "scope", "type": "string", "label": "操作域" },
        { "name": "product", "type": "string", "label": "处理的商品" },
        { "name": "images", "type": "json", "label": "输入图预览" },
        { "name": "message", "type": "text", "label": "内容" },
        { "name": "created_at", "type": "datetime", "label": "时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["level"], ["created_at"]]
    },
    {
      "name": "etsy_forge_runs",
      "label": "采集批次",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "kind", "type": "enum", "label": "批次类型", "options": ["list_collect", "detail_collect", "self_check"], "default": "list_collect", "indexed": true },
        { "name": "keyword", "type": "string", "label": "关键词" },
        { "name": "products_found", "type": "integer", "label": "找到商品数", "default": 0 },
        { "name": "ehunt_ok_count", "type": "integer", "label": "EHunt 命中数", "default": 0 },
        { "name": "images_collected", "type": "integer", "label": "采集详情图数", "default": 0 },
        { "name": "status", "type": "enum", "label": "状态", "options": ["running", "success", "failed", "cancelled", "partial"], "default": "running", "indexed": true },
        { "name": "failure_reason", "type": "text", "label": "失败原因" },
        { "name": "started_at", "type": "datetime", "label": "开始时间", "indexed": true },
        { "name": "ended_at", "type": "datetime", "label": "结束时间" },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["kind"], ["status"], ["started_at"]]
    },
    {
      "name": "app_settings",
      "label": "应用设置",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "ai_system_prompt", "type": "text", "label": "采集说明 / 提示词 (ai_system_prompt)" },
        { "name": "risk_note", "type": "text", "label": "风险边界 (risk_note)" },
        { "name": "browser_context_id", "type": "string", "label": "采集用浏览器上下文", "default": "embedded:default" },
        { "name": "ai_provider_id", "type": "string", "label": "AI 分析服务商（评论分析用，留空=全局默认）" },
        { "name": "ai_model", "type": "string", "label": "AI 分析模型（留空=该服务商首个模型）" },
        { "name": "vision_provider_id", "type": "string", "label": "识图服务商（图片分类/二创拆解/质检用，留空=图片服务商兜底）" },
        { "name": "vision_model", "type": "string", "label": "识图模型（留空=默认 gemini）" },
        { "name": "image_concurrency", "type": "integer", "label": "图片生成并发度（默认 5）", "default": 5 },
        { "name": "max_pose", "type": "integer", "label": "每商品抠姿势上限（默认 3）", "default": 3 },
        { "name": "default_max_products", "type": "integer", "label": "默认每次爬商品数", "default": 24 },
        { "name": "download_detail_images", "type": "boolean", "label": "详情图下载到本地（否则仅存 URL）", "default": false },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["updated_at"]]
    },
    {
      "name": "app_automations",
      "label": "自动化",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "title", "type": "string", "label": "名称", "required": true, "indexed": true },
        { "name": "enabled", "type": "boolean", "label": "启用", "default": false, "indexed": true },
        { "name": "schedule", "type": "string", "label": "触发规则", "default": "未设置" },
        { "name": "native_action", "type": "string", "label": "执行动作", "default": "", "indexed": true },
        { "name": "description", "type": "text", "label": "说明" },
        { "name": "last_status", "type": "enum", "label": "最近状态", "options": ["not_connected", "idle", "running", "success", "failed", "cancelled"], "default": "not_connected", "indexed": true },
        { "name": "last_run_summary", "type": "text", "label": "最近结果" },
        { "name": "last_run_id", "type": "string", "label": "最近运行记录" },
        { "name": "schedule_id", "type": "string", "label": "调度任务 ID" },
        { "name": "schedule_status", "type": "enum", "label": "调度状态", "options": ["not_connected", "scheduled", "paused", "failed"], "default": "not_connected", "indexed": true },
        { "name": "schedule_error", "type": "text", "label": "调度失败原因" },
        { "name": "next_run_at", "type": "datetime", "label": "下次运行时间" },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["enabled"], ["native_action"], ["last_status"], ["schedule_status"], ["updated_at"]]
    },
    {
      "name": "run_history",
      "label": "运行结果",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "title", "type": "string", "label": "运行标题", "required": true, "indexed": true },
        { "name": "status", "type": "enum", "label": "状态", "options": ["running", "success", "failed", "cancelled"], "default": "running", "indexed": true },
        { "name": "summary", "type": "text", "label": "结果摘要" },
