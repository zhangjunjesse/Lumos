{
  "$schema": "https://lumos.io/schemas/app-data-schema.v1.json",
  "collections": [
    {
      "name": "etsy_forge_collection_tasks",
      "label": "关键词采集任务",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "keyword", "type": "string", "label": "关键词", "required": true, "indexed": true },
        { "name": "source", "type": "enum", "label": "平台", "options": ["etsy"], "default": "etsy", "indexed": true },
        { "name": "enabled", "type": "boolean", "label": "启用", "default": true, "indexed": true },
        { "name": "schedule", "type": "enum", "label": "调度频率", "options": ["manual", "hourly", "daily", "weekly"], "default": "manual", "indexed": true },
        { "name": "max_products", "type": "integer", "label": "每次爬商品数", "default": 24 },
        { "name": "total_collected", "type": "integer", "label": "累积商品数", "default": 0 },
        { "name": "last_run_id", "type": "string", "label": "最近运行记录" },
        { "name": "last_run_at", "type": "datetime", "label": "最近运行时间", "indexed": true },
        { "name": "last_status", "type": "enum", "label": "最近状态", "options": ["idle", "running", "success", "failed", "partial", "cancelled"], "default": "idle", "indexed": true },
        { "name": "last_failure_reason", "type": "text", "label": "最近失败原因" },
        { "name": "last_collected_count", "type": "integer", "label": "最近一次商品数", "default": 0 },
        { "name": "next_run_at", "type": "datetime", "label": "下次运行时间" },
        { "name": "created_at", "type": "datetime", "label": "创建时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["keyword"], ["source"], ["enabled"], ["schedule"], ["last_status"], ["last_run_at"]]
    },
    {
      "name": "etsy_forge_products",
      "label": "采集到的商品",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "task_id", "type": "string", "label": "采集任务", "indexed": true },
        { "name": "keyword", "type": "string", "label": "关键词", "indexed": true },
        { "name": "source", "type": "enum", "label": "平台", "options": ["etsy"], "default": "etsy" },
        { "name": "listing_id", "type": "string", "label": "Etsy listing ID", "indexed": true },
        { "name": "title", "type": "text", "label": "标题" },
        { "name": "url", "type": "string", "label": "商品 URL", "required": true },
        { "name": "main_image_url", "type": "string", "label": "主图 URL" },
        { "name": "price", "type": "string", "label": "价格" },
        { "name": "rating", "type": "string", "label": "评分" },
        { "name": "reviews", "type": "string", "label": "评论数" },
        { "name": "sales", "type": "string", "label": "销量(列表展示)" },
        { "name": "ehunt_json", "type": "text", "label": "EHunt 指标（JSON：销量/收藏/上架日期等）" },
        { "name": "ehunt_status", "type": "enum", "label": "EHunt 采集状态", "options": ["ok", "no_ehunt", "not_adspower", "bridge_unavailable", "failed"], "default": "failed", "indexed": true },
        { "name": "selected", "type": "boolean", "label": "已勾选（待爬详情）", "default": false, "indexed": true },
        { "name": "detail_status", "type": "enum", "label": "详情图采集状态", "options": ["idle", "running", "success", "failed"], "default": "idle", "indexed": true },
        { "name": "detail_image_count", "type": "integer", "label": "已采集详情图数", "default": 0 },
        { "name": "detail_failure_reason", "type": "text", "label": "详情采集失败原因" },
        { "name": "created_at", "type": "datetime", "label": "采集时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["task_id"], ["keyword"], ["listing_id"], ["selected"], ["detail_status"], ["ehunt_status"], ["created_at"]]
    },
    {
      "name": "etsy_forge_images",
      "label": "详情图（图库）",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "product_id", "type": "string", "label": "所属商品", "required": true, "indexed": true },
        { "name": "listing_id", "type": "string", "label": "Etsy listing ID", "indexed": true },
        { "name": "keyword", "type": "string", "label": "来源关键词", "indexed": true },
        { "name": "image_url", "type": "string", "label": "详情图 URL", "required": true },
        { "name": "local_path", "type": "string", "label": "下载后本地路径" },
        { "name": "is_main", "type": "boolean", "label": "是否主图", "default": false },
        { "name": "position", "type": "integer", "label": "在详情页顺序", "default": 0 },
        { "name": "created_at", "type": "datetime", "label": "采集时间", "indexed": true },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["product_id"], ["listing_id"], ["keyword"], ["created_at"]]
    },
    {
      "name": "etsy_forge_runs",
      "label": "采集批次",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "user_id", "type": "string", "label": "用户", "indexed": true },
        { "name": "kind", "type": "enum", "label": "批次类型", "options": ["list_collect", "detail_collect", "self_check"], "default": "list_collect", "indexed": true },
        { "name": "keyword", "type": "string", "label": "关键词" },
        { "name": "products_found", "type": "integer", "label": "找到商品数", "default": 0 },
        { "name": "ehunt_ok_count", "type": "integer", "label": "EHunt 命中数", "default": 0 },
        { "name": "images_collected", "type": "integer", "label": "采集详情图数", "default": 0 },
        { "name": "status", "type": "enum", "label": "状态", "options": ["running", "success", "failed", "cancelled", "partial"], "default": "running", "indexed": true },
        { "name": "failure_reason", "type": "text", "label": "失败原因" },
        { "name": "started_at", "type": "datetime", "label": "开始时间", "indexed": true },
        { "name": "ended_at", "type": "datetime", "label": "结束时间" },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["user_id"], ["kind"], ["status"], ["started_at"]]
    },
    {
      "name": "app_settings",
      "label": "应用设置",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "ai_system_prompt", "type": "text", "label": "采集说明 / 提示词 (ai_system_prompt)" },
        { "name": "risk_note", "type": "text", "label": "风险边界 (risk_note)" },
        { "name": "browser_context_id", "type": "string", "label": "采集用浏览器上下文", "default": "embedded:default" },
        { "name": "default_max_products", "type": "integer", "label": "默认每次爬商品数", "default": 24 },
        { "name": "download_detail_images", "type": "boolean", "label": "详情图下载到本地（否则仅存 URL）", "default": false },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["updated_at"]]
    },
    {
      "name": "app_automations",
      "label": "自动化",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "title", "type": "string", "label": "名称", "required": true, "indexed": true },
        { "name": "enabled", "type": "boolean", "label": "启用", "default": false, "indexed": true },
        { "name": "schedule", "type": "string", "label": "触发规则", "default": "未设置" },
        { "name": "native_action", "type": "string", "label": "执行动作", "default": "", "indexed": true },
        { "name": "description", "type": "text", "label": "说明" },
        { "name": "last_status", "type": "enum", "label": "最近状态", "options": ["not_connected", "idle", "running", "success", "failed", "cancelled"], "default": "not_connected", "indexed": true },
        { "name": "last_run_summary", "type": "text", "label": "最近结果" },
        { "name": "last_run_id", "type": "string", "label": "最近运行记录" },
        { "name": "schedule_id", "type": "string", "label": "调度任务 ID" },
        { "name": "schedule_status", "type": "enum", "label": "调度状态", "options": ["not_connected", "scheduled", "paused", "failed"], "default": "not_connected", "indexed": true },
        { "name": "schedule_error", "type": "text", "label": "调度失败原因" },
        { "name": "next_run_at", "type": "datetime", "label": "下次运行时间" },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["enabled"], ["native_action"], ["last_status"], ["schedule_status"], ["updated_at"]]
    },
    {
      "name": "run_history",
      "label": "运行结果",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "title", "type": "string", "label": "运行标题", "required": true, "indexed": true },
        { "name": "status", "type": "enum", "label": "状态", "options": ["running", "success", "failed", "cancelled"], "default": "running", "indexed": true },
        { "name": "summary", "type": "text", "label": "结果摘要" },
        { "name": "failure_reason", "type": "text", "label": "失败原因" },
        { "name": "kind", "type": "enum", "label": "运行类型", "options": ["list_collect", "detail_collect", "self_check"], "indexed": true },
        { "name": "ref_id", "type": "string", "label": "关联实体 ID（如 etsy_forge_runs.id）", "indexed": true },
        { "name": "workflow_run_id", "type": "string", "label": "OpenWorkflow run ID" },
        { "name": "schedule_run_history_id", "type": "string", "label": "schedule_run_history ID" },
        { "name": "started_at", "type": "datetime", "label": "开始时间" },
        { "name": "ended_at", "type": "datetime", "label": "结束时间" },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["status"], ["kind"], ["ref_id"], ["updated_at"]]
    },
    {
      "name": "assistant_messages",
      "label": "AI 助手对话",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "role", "type": "enum", "label": "角色", "options": ["user", "assistant"], "required": true, "indexed": true },
        { "name": "text", "type": "text", "label": "消息内容", "required": true },
        { "name": "error", "type": "boolean", "label": "是否失败", "default": false },
        { "name": "created_at", "type": "datetime", "label": "创建时间" },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["role"], ["updated_at"]]
    },
    {
      "name": "app_notifications",
      "label": "通知目标",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "channel", "type": "enum", "label": "渠道", "options": ["system", "wechat_im"], "default": "system", "indexed": true },
        { "name": "provider_id", "type": "string", "label": "IM 服务商", "default": "wechat" },
        { "name": "chat_id", "type": "string", "label": "会话 ID" },
        { "name": "target_label", "type": "string", "label": "目标", "required": true, "indexed": true },
        { "name": "title", "type": "string", "label": "通知标题", "default": "Etsy 商品采集" },
        { "name": "text", "type": "text", "label": "通知正文" },
        { "name": "status", "type": "enum", "label": "状态", "options": ["not_connected", "ready", "sent", "failed"], "default": "not_connected", "indexed": true },
        { "name": "last_error", "type": "text", "label": "失败原因" },
        { "name": "last_message_id", "type": "string", "label": "最近消息 ID" },
        { "name": "last_sent_at", "type": "datetime", "label": "最近发送时间" },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["channel"], ["status"], ["updated_at"]]
    },
    {
      "name": "app_command_runs",
      "label": "IM 命令",
      "fields": [
        { "name": "id", "type": "uuid", "primary": true, "auto": "uuid" },
        { "name": "command", "type": "string", "label": "命令", "required": true, "indexed": true },
        { "name": "risk_level", "type": "enum", "label": "风险", "options": ["read", "low_write", "high_risk"], "default": "read", "indexed": true },
        { "name": "confirmation_required", "type": "boolean", "label": "需要确认", "default": true },
        { "name": "status", "type": "enum", "label": "状态", "options": ["not_connected", "draft", "pending_confirmation", "success", "failed", "rejected"], "default": "not_connected", "indexed": true },
        { "name": "result_summary", "type": "text", "label": "结果" },
        { "name": "failure_reason", "type": "text", "label": "失败原因" },
        { "name": "last_run_id", "type": "string", "label": "最近运行记录" },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["command"], ["risk_level"], ["status"], ["updated_at"]]
    },
    {
      "name": "acceptance_checks",
      "label": "验收清单",
      "fields": [
        { "name": "id", "type": "string", "primary": true },
        { "name": "acceptance_id", "type": "string", "label": "验收项 ID", "required": true, "indexed": true },
        { "name": "done", "type": "boolean", "label": "已验收", "default": false },
        { "name": "status", "type": "enum", "label": "验收状态", "options": ["unverified", "passed", "failed", "blocked"], "default": "unverified", "indexed": true },
        { "name": "evidence", "type": "text", "label": "验收证据" },
        { "name": "failure_reason", "type": "text", "label": "失败或阻塞原因" },
        { "name": "evidence_run_id", "type": "string", "label": "关联运行记录" },
        { "name": "completed_at", "type": "datetime", "label": "验收时间" },
        { "name": "updated_at", "type": "datetime", "label": "更新时间", "auto": "now" }
      ],
      "indexes": [["acceptance_id"], ["status"], ["updated_at"]]
    }
  ]
}
