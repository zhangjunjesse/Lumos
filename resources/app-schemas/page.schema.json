{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumos.io/schemas/app-page.v1.json",
  "title": "Lumos App Page",
  "description": "pages/<id>.json — declarative UI for one page. Supports 4 layouts: single | form | list-detail | result. v1 widget set ~15 components.",
  "type": "object",
  "required": ["title", "layout"],
  "additionalProperties": false,

  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 256 },
    "layout": {
      "type": "string",
      "enum": ["single", "form", "list-detail", "result"]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/widget" }
    },
    "form": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/formField" }
    },
    "submit": { "$ref": "#/$defs/submitAction" },
    "list": { "$ref": "#/$defs/listView" },
    "detail": { "$ref": "#/$defs/detailView" },
    "source": {
      "type": "object",
      "required": ["run"],
      "additionalProperties": false,
      "properties": {
        "run": { "$ref": "#/$defs/eventDsl" },
        "input": { "type": "object" }
      }
    },
    "render": {
      "type": "string",
      "enum": ["markdown", "json", "table", "text"]
    }
  },

  "allOf": [
    {
      "if": { "properties": { "layout": { "const": "single" } }, "required": ["layout"] },
      "then": { "required": ["blocks"] }
    },
    {
      "if": { "properties": { "layout": { "const": "form" } }, "required": ["layout"] },
      "then": { "required": ["form", "submit"] }
    },
    {
      "if": { "properties": { "layout": { "const": "list-detail" } }, "required": ["layout"] },
      "then": { "required": ["list", "detail"] }
    },
    {
      "if": { "properties": { "layout": { "const": "result" } }, "required": ["layout"] },
      "then": { "required": ["source", "render"] }
    }
  ],

  "$defs": {
    "binding": {
      "type": "string",
      "description": "Template expression like '{{ db.customers }}' or '{{ inputs.name }}'",
      "pattern": "^\\{\\{\\s*[a-zA-Z_][\\w.\\[\\]'\",:\\s()-]*\\s*\\}\\}$"
    },
    "eventDsl": {
      "type": "string",
      "description": "Event string: 'workflow:<id>' | 'db:create:<col>' | 'db:update:<col>' | 'db:delete:<col>' | 'page:<id>' | 'dialog:<id>'",
      "pattern": "^(workflow:[a-z][a-z0-9-]{0,63}|db:(create|update|delete):[a-z][a-z0-9_]{0,63}|page:[a-z][a-z0-9-]{0,63}|dialog:[a-z][a-z0-9-]{0,63})$"
    },

    "widget": {
      "oneOf": [
        { "$ref": "#/$defs/widgetCard" },
        { "$ref": "#/$defs/widgetMarkdown" },
        { "$ref": "#/$defs/widgetTable" },
        { "$ref": "#/$defs/widgetTag" },
        { "$ref": "#/$defs/widgetBadge" },
        { "$ref": "#/$defs/widgetButton" },
        { "$ref": "#/$defs/widgetLink" }
      ]
    },

    "widgetCard": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "card" },
        "title": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/widget" }
        }
      }
    },
    "widgetMarkdown": {
      "type": "object",
      "required": ["type", "content"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "markdown" },
        "content": { "type": "string", "description": "Plain markdown or template expression" }
      }
    },
    "widgetTable": {
      "type": "object",
      "required": ["type", "data", "columns"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "table" },
        "data": { "$ref": "#/$defs/binding" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field", "label"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "label": { "type": "string" },
              "render": { "type": "string", "enum": ["text", "tag", "badge", "date", "markdown", "link"] },
              "sortable": { "type": "boolean" },
              "search": { "type": "boolean" }
            }
          }
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          }
        },
        "filter": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": { "type": "array", "items": { "$ref": "#/$defs/actionItem" } },
            "toolbar": { "type": "array", "items": { "$ref": "#/$defs/actionItem" } }
          }
        }
      }
    },
    "widgetTag": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "tag" },
        "value": { "type": "string" },
        "color": { "type": "string", "enum": ["default", "primary", "success", "warning", "danger"] }
      }
    },
    "widgetBadge": {
      "type": "object",
      "required": ["type", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "badge" },
        "value": { "type": "string" }
      }
    },
    "widgetButton": {
      "type": "object",
      "required": ["type", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "button" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "primary": { "type": "boolean", "default": false },
        "run": { "$ref": "#/$defs/eventDsl" },
        "open": { "$ref": "#/$defs/eventDsl" },
        "input": { "type": "object" },
        "confirm": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string", "description": "Confirmation message" }
          ]
        },
        "disabled": { "$ref": "#/$defs/binding" }
      },
      "anyOf": [
        { "required": ["run"] },
        { "required": ["open"] }
      ]
    },
    "widgetLink": {
      "type": "object",
      "required": ["type", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "link" },
        "label": { "type": "string" },
        "open": { "$ref": "#/$defs/eventDsl" }
      }
    },

    "formField": {
      "oneOf": [
        { "$ref": "#/$defs/fieldText" },
        { "$ref": "#/$defs/fieldTextarea" },
        { "$ref": "#/$defs/fieldSelect" },
        { "$ref": "#/$defs/fieldCheckbox" },
        { "$ref": "#/$defs/fieldSwitch" },
        { "$ref": "#/$defs/fieldFile" },
        { "$ref": "#/$defs/fieldNumber" }
      ]
    },
    "fieldBase": {
      "type": "object",
      "required": ["type", "name", "label"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 },
        "required": { "type": "boolean", "default": false },
        "placeholder": { "type": "string" },
        "default": {},
        "description": { "type": "string", "maxLength": 256 }
      }
    },
    "fieldText": {
      "allOf": [{ "$ref": "#/$defs/fieldBase" }],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "text" },
        "name": true, "label": true, "required": true, "placeholder": true, "default": true, "description": true,
        "maxLength": { "type": "integer", "minimum": 1 },
        "pattern": { "type": "string" }
      }
    },
    "fieldTextarea": {
      "allOf": [{ "$ref": "#/$defs/fieldBase" }],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "textarea" },
        "name": true, "label": true, "required": true, "placeholder": true, "default": true, "description": true,
        "rows": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "fieldSelect": {
      "allOf": [{ "$ref": "#/$defs/fieldBase" }],
      "required": ["options"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "select" },
        "name": true, "label": true, "required": true, "placeholder": true, "default": true, "description": true,
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["value", "label"],
                "additionalProperties": false,
                "properties": {
                  "value": { "type": ["string", "number"] },
                  "label": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "fieldCheckbox": {
      "allOf": [{ "$ref": "#/$defs/fieldBase" }],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "checkbox" },
        "name": true, "label": true, "required": true, "default": true, "description": true
      }
    },
    "fieldSwitch": {
      "allOf": [{ "$ref": "#/$defs/fieldBase" }],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "switch" },
        "name": true, "label": true, "required": true, "default": true, "description": true
      }
    },
    "fieldFile": {
      "allOf": [{ "$ref": "#/$defs/fieldBase" }],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "file" },
        "name": true, "label": true, "required": true, "description": true,
        "accept": { "type": "string", "description": "MIME types or extensions, comma-separated" },
        "multiple": { "type": "boolean", "default": false }
      }
    },
    "fieldNumber": {
      "allOf": [{ "$ref": "#/$defs/fieldBase" }],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "number" },
        "name": true, "label": true, "required": true, "placeholder": true, "default": true, "description": true,
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" }
      }
    },

    "actionItem": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "primary": { "type": "boolean" },
        "run": { "$ref": "#/$defs/eventDsl" },
        "open": { "$ref": "#/$defs/eventDsl" },
        "input": { "type": "object" },
        "confirm": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string" }
          ]
        }
      },
      "anyOf": [
        { "required": ["run"] },
        { "required": ["open"] }
      ]
    },

    "submitAction": {
      "type": "object",
      "required": ["label", "run"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "run": { "$ref": "#/$defs/eventDsl" },
        "input": { "type": "object" },
        "render": { "type": "string", "enum": ["markdown", "json", "table", "text", "none"] }
      }
    },

    "listView": {
      "type": "object",
      "required": ["type", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "table" },
        "data": { "$ref": "#/$defs/binding" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["field", "label"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "label": { "type": "string" },
              "render": { "type": "string", "enum": ["text", "tag", "badge", "date", "markdown", "link"] },
              "sortable": { "type": "boolean" },
              "search": { "type": "boolean" }
            }
          }
        },
        "filter": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "row": { "type": "array", "items": { "$ref": "#/$defs/actionItem" } },
            "toolbar": { "type": "array", "items": { "$ref": "#/$defs/actionItem" } }
          }
        }
      }
    },

    "detailView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tabs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "view"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "maxLength": 32 },
              "view": { "$ref": "#/$defs/detailViewBody" }
            }
          }
        },
        "view": { "$ref": "#/$defs/detailViewBody" }
      },
      "oneOf": [
        { "required": ["tabs"], "not": { "required": ["view"] } },
        { "required": ["view"], "not": { "required": ["tabs"] } }
      ]
    },

    "detailViewBody": {
      "oneOf": [
        {
          "type": "object",
          "required": ["form"],
          "additionalProperties": false,
          "properties": {
            "form": {
              "type": "array",
              "items": { "$ref": "#/$defs/formField" }
            },
            "submit": { "$ref": "#/$defs/submitAction" }
          }
        },
        {
          "type": "object",
          "required": ["type", "data"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "table" },
            "data": { "$ref": "#/$defs/binding" }
          }
        },
        {
          "type": "object",
          "required": ["type", "run"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "result" },
            "run": { "$ref": "#/$defs/eventDsl" },
            "input": { "type": "object" },
            "render": { "type": "string", "enum": ["markdown", "json", "table", "text"] }
          }
        }
      ]
    }
  }
}
