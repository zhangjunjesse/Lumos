{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumos.io/schemas/app-workflow-ref.v1.json",
  "title": "Lumos App Workflow Reference",
  "description": "Minimal contract for workflow files inside an app package. The full Workflow DSL V2 is owned by src/lib/workflow/; this schema only specifies the fields the app platform reads (id, name, version, inputs, outputs). Step bodies are passed through to the workflow engine as-is.",
  "type": "object",
  "required": ["id", "version", "steps"],

  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "description": "Workflow id; referenced from page events as 'workflow:<id>' and from triggers as 'workflow'"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "description": { "type": "string", "maxLength": 500 },
    "version": {
      "type": "integer",
      "minimum": 2,
      "maximum": 2,
      "description": "App platform v1 only supports Workflow DSL V2"
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/inputDef" },
      "description": "Input parameters; used by 'workflow promotion' to derive a form page"
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/outputDef" },
      "description": "Output declaration; used to derive a result page renderer"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "type": { "type": "string" }
        }
      },
      "description": "Step bodies validated by workflow engine, not here"
    }
  },

  "$defs": {
    "inputDef": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "label": { "type": "string", "maxLength": 64 },
        "type": {
          "type": "string",
          "enum": ["string", "text", "number", "boolean", "select", "file", "date", "json"]
        },
        "required": { "type": "boolean", "default": false },
        "default": {},
        "options": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string", "maxLength": 256 }
      }
    },
    "outputDef": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "type": {
          "type": "string",
          "enum": ["string", "markdown", "json", "table", "file"]
        },
        "label": { "type": "string", "maxLength": 64 }
      }
    }
  }
}
