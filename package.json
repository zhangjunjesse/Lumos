{
  "name": "lumos",
  "version": "0.39.28",
  "private": true,
  "author": {
    "name": "op7418",
    "email": "7418@openclaw.ai"
  },
  "description": "A native desktop GUI client for Claude Code",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/next-build.mjs",
    "build:open": "cross-env NEXT_PUBLIC_LUMOS_EDITION=open node scripts/next-build.mjs",
    "build:pro": "cross-env NEXT_PUBLIC_LUMOS_EDITION=pro node scripts/next-build.mjs",
    "start": "next start",
    "test": "jest",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ci:verify": "npm run typecheck && npm run build",
    "ci:verify:strict": "npm run lint -- --max-warnings=0 && npm run typecheck && npm run build",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build:app-runtime": "node scripts/build-app-runtime.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:build": "npm rebuild better-sqlite3 && node scripts/download-node.mjs && node scripts/download-python-runtime.mjs && node scripts/download-git-bash.mjs && node scripts/download-ffmpeg.mjs && npm run build && node scripts/build-electron.mjs",
    "electron:build:pro": "cross-env NEXT_PUBLIC_LUMOS_EDITION=pro npm run electron:build",
    "electron:build:open": "cross-env NEXT_PUBLIC_LUMOS_EDITION=open npm run electron:build",
    "electron:pack": "npm run electron:build && electron-builder --config electron-builder.yml",
    "electron:pack:mac": "npm run electron:build && electron-builder --mac --config electron-builder.yml && node scripts/verify-packaged-esbuild.mjs --platform=darwin --arch=arm64 release/mac-arm64/Lumos.app && node scripts/verify-packaged-esbuild.mjs --platform=darwin --arch=x64 release/mac/Lumos.app",
    "electron:pack:win": "npm run electron:build && node scripts/download-python-runtime.mjs --platform win32 --arch x64 && node scripts/download-git-bash.mjs --platform win32 --arch x64 && node scripts/download-ffmpeg.mjs --platform win32 --arch x64 && electron-builder --win --config electron-builder.yml && node scripts/verify-packaged-esbuild.mjs --platform=win32 --arch=x64 release/win-unpacked",
    "electron:pack:linux": "npm run electron:build && electron-builder --linux --config electron-builder.yml",
    "electron:pack:pro": "npm run electron:build:pro && electron-builder --config electron-builder.yml",
    "electron:pack:pro:mac": "npm run electron:build:pro && electron-builder --mac --config electron-builder.yml && node scripts/verify-packaged-esbuild.mjs --platform=darwin --arch=arm64 release/mac-arm64/Lumos.app && node scripts/verify-packaged-esbuild.mjs --platform=darwin --arch=x64 release/mac/Lumos.app",
    "electron:pack:pro:win": "npm run electron:build:pro && node scripts/download-python-runtime.mjs --platform win32 --arch x64 && node scripts/download-git-bash.mjs --platform win32 --arch x64 && node scripts/download-ffmpeg.mjs --platform win32 --arch x64 && electron-builder --win --config electron-builder.yml && node scripts/verify-packaged-esbuild.mjs --platform=win32 --arch=x64 release/win-unpacked",
    "validate:native-app": "node scripts/validate-native-app.mjs",
    "runtime-resources:manifest": "node scripts/build-runtime-resource-manifest.mjs",
    "lumos-app": "node scripts/lumos-app.mjs"
  },
